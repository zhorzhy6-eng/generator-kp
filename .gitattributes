# Нормализация переводов строк.
# Windows-скрипты (.bat) обязаны иметь CRLF, остальное храним в LF.

* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Хуки git — это sh-скрипты. Если Windows-версия git переведёт их в CRLF,
# они перестанут запускаться (ошибка «bad interpreter»).
scripts/pre-commit text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.docx binary
