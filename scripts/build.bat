@echo off
chcp 65001 >nul
setlocal

:: ============================================================
::  Сборка автономного EXE «Генератора КП»
:: ============================================================
::  Просто вызывает scripts\setup.py, который делает всё сам:
::  ставит зависимости, защищает репозиторий hook-ом,
::  собирает EXE через spec-файлы, копирует на рабочий стол
::  и проверяет, что программа запускается.
::
::  Ключи setup.py можно передать этому файлу как есть, например:
::      build.bat --skip-template
::      build.bat --build-only
:: ============================================================

echo ============================================================
echo   СБОРКА ГЕНЕРАТОРА КП
echo ============================================================
echo.

:: Проверяем, что Python доступен
python --version >nul 2>&1
if errorlevel 1 (
    echo [ОШИБКА] Python не найден в PATH.
    echo.
    echo Установите Python 3.9+ и включите галочку
    echo "Add Python to PATH" при установке:
    echo    https://www.python.org/downloads/
    echo.
    pause
    exit /b 1
)

echo Запускаю установщик и сборку...
echo.
python "%~dp0setup.py" %*
set "RC=%ERRORLEVEL%"

echo.
if "%RC%"=="0" (
    echo [ГОТОВО] Сборка завершена успешно.
) else (
    echo [ОШИБКА] Сборка завершилась с кодом %RC%.
    echo Прокрутите вывод выше и найдите строки с пометкой [X].
)
echo.
pause
exit /b %RC%
