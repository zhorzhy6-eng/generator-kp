# ============================================
# GigaChat API — https://developers.sber.ru/
# ============================================
# Authorization Key (base64), получите в личном кабинете
GIGACHAT_CREDENTIALS=

# Scope: GIGACHAT_API_PERS | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель
GIGACHAT_MODEL=GigaChat

# Таймаут запроса (сек). 60 — с запасом на медленную сеть
GIGACHAT_TIMEOUT=60

# Адрес API GigaChat.
# ВАЖНО: с версии библиотеки gigachat 0.2.0 значением по умолчанию стал
# https://api.giga.chat/v1, а он доступен НЕ из всех сетей — запрос падает
# с ConnectTimeout [WinError 10060]. Классический адрес Сбера работает
# стабильно, поэтому он указан здесь явно. Пустая строка = взять адрес
# по умолчанию из кода (тоже адрес Сбера).
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1

# Проверка SSL (true — рекомендовано; false — только для отладки)
GIGACHAT_VERIFY_SSL_CERTS=true

# Путь к корневому сертификату Минцифры (если установлен локально)
# Скачать: https://gu-st.ru/content/Other/doc/russian_trusted_root_ca.cer
GIGACHAT_CA_BUNDLE_FILE=
